      "slug": "spin-crush",
      "review_count": 133,
      "more_information_url": "U2FsdGVkX18QyABZOaU0rCyX5WWH3n1I/afpMwqWV9rsG/L5upr4reGD6UwOE4NPih7DWpa5EDCLKDYCuRCFcA==",
      "encrypted_link": "U2FsdGVkX18QyABZOaU0rCyX5WWH3n1I/afpMwqWV9rsG/L5upr4reGD6UwOE4NPih7DWpa5EDCLKDYCuRCFcA=="
